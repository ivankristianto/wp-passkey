includes:
  - vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
  level: 6
  tmpDir: .config/cache/phpstan/
  paths:
    - plugin.php
    - inc
  excludePaths:
    analyse:
      - wordpress
  ignoreErrors:
      # Deserialized WebAuthn payloads are re-checked at runtime even though their PHPDoc types say otherwise.
      -
        identifier: instanceof.alwaysTrue
        path: inc/class-webauthn-server.php
        count: 2
